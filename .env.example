# ============================================
# BiRiBi Contracts - Environment Variables
# ============================================
# Hardhat uses `npx hardhat vars set <NAME>` to store secrets.
# This file documents all variables used by hardhat.config.ts and hardhat.network.ts.

# ===== Deployer Key (required for any non-local network) =====
# Private key of the deployer wallet (without 0x prefix)
# BRB_KEY=

# ===== RPC URLs (set only the networks you need) =====
# Arbitrum (production)
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum Sepolia (testnet)
# ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Ethereum Mainnet
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Ethereum Testnets
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# HOLESKY_RPC_URL=https://ethereum-holesky-rpc.publicnode.com
# GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_KEY

# Other L1/L2 networks
# GNOSIS_RPC_URL=https://rpc.gnosischain.com
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# BSCTEST_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# MATIC_RPC_URL=https://polygon-rpc.com
# MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Tenderly fork (for simulation & debugging)
# TENDERLY_RPC_URL=https://rpc.tenderly.co/fork/YOUR_FORK_ID

# ===== Verification & Reporting =====
# Etherscan/Arbiscan API key — used for contract verification and gas reporting
# ETHERSCAN_API_KEY=

# CoinMarketCap API key — enables USD/EUR gas cost estimates in test output
# REPORT_GAS=
